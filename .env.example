# Database URL (Neon Serverless PostgreSQL yoki Vercel Postgres)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Auth Sessions
JWT_SECRET="lexora-secret-key-production-2026"

# Google Gemini AI API Key (Ixtiyoriy - kiritilmasa yuqori aniqlikdagi evristik fallback ishlaydi)
GEMINI_API_KEY=""

# Telegram Bot (Vercel Serverless Webhook integratsiyasi)
# @BotFather orqali olingan token:
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Bot username (masalan: lexora_uzbot):
TELEGRAM_BOT_USERNAME="lexora_uzbot"
# Ilovangizning Vercel domeni (Webhook va WebApp integratsiyasi uchun):
NEXT_PUBLIC_APP_URL="https://lexora.vercel.app"
# Webhook xavfsizligi uchun maxfiy token (ixtiyoriy, ixtiyoriy matn):
TELEGRAM_WEBHOOK_SECRET="lexora_super_secret_webhook_key_2026"
